{
  "name": "ascend-env",
  "version": "0.1.0",
  "description": "Ascend CANN 环境部署工具：静态页面前端 + 本地 Node.js 辅助服务",
  "type": "module",
  "bin": {
    "ascend-env": "dist/cli/main.js"
  },
  "files": [
    "dist",
    "catalog",
    "templates"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node build.mjs",
    "typecheck": "tsc --noEmit",
    "dev": "tsx src/cli/main.ts",
    "start": "node dist/cli/main.js",
    "test": "node --import tsx --test \"test/**/*.test.ts\""
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "ssh2": "^1.16.0",
    "tar-stream": "^3.1.7",
    "ws": "^8.18.0",
    "yaml": "^2.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ssh2": "^1.15.0",
    "@types/tar-stream": "^3.1.3",
    "@types/ws": "^8.5.12",
    "esbuild": "^0.24.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}